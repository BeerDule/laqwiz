# Quizz Canapé — configuration LLM (optionnelle)
# Vous pouvez laisser ces valeurs vides : chaque joueur pourra alors
# renseigner ses propres identifiants depuis l'écran de configuration
# (modèle BYOK — Bring Your Own Key).
#
# Pour un usage "tout serveur" (sans configuration côté client), remplissez
# les trois premières variables ci-dessous.

# URL racine du provider OpenAI-compatible (sans slash final)
# Défaut Mammouth ; autres exemples :
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1          (Ollama local)
LLM_BASE_URL=https://api.mammouth.ai/v1

# Clé API du provider (JAMAIS versionnée, JAMAIS exposée au navigateur)
LLM_API_KEY=

# Identifiant du modèle à utiliser
LLM_MODEL=mammouth-chat

# Température de sampling (0 = déterministe, 2 = chaos)
LLM_TEMPERATURE=0.9

# Nombre de questions générées par appel API (recommandé : 8)
LLM_BATCH_SIZE=8

# Faut-il que chaque joueur saisisse ses propres identifiants LLM (mode BYOK) ?
#   false  = non, le serveur fournit la configuration ci-dessus
#   true   = oui, même en développement
#   absent = obligatoire en production, optionnel en développement
#
# ATTENTION : cette valeur est figée à la COMPILATION du front (injectée par
# vite.config.js). La changer impose de rebuilder — ce n'est pas un réglage
# modifiable à chaud.
LLM_CONFIG_REQUIRED=

# Mode « Safe For Work » (école / tout public). Activable au DÉMARRAGE du serveur,
# sans rebuild : le front lit /api/health et masque l'option « Adulte (NSFW) » ainsi
# que le mode « Canap' éro ». Le proxy force aussi le public « adulte » vers
# « tout public » (un client trafiqué ne peut pas rejouer du NSFW).
#   1 / true / yes / on  = actif
#   absent / autre       = désactivé (comportement normal)
SFW_MODE=

# Relais WebSocket multijoueur (auto-hébergé, server/relay.mjs).
# Le front y accède via une URL configurable à la COMPILATION. Laisser vide
# pour utiliser le relais local en dev (:3000) ou la même origine en prod
# (le relais peut servir dist/). Exemple :
#   VITE_RELAY_ORIGIN=https://quiz.example.com
VITE_RELAY_ORIGIN=

# Serveurs ICE (STUN/TURN) pour les connexions WebRTC directes (P2P).
# Défaut : un STUN public Google (suffit pour la plupart des box). Pour les NAT
# symétriques, fournir un TURN (tableau JSON d'iceServers), figé à la compilation.
# Exemple :
#   VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=

# ===== Mode payant (comptes Google + crédits) =================================
# Activer le gate : la clé LLM du serveur (.env) n'est alors servie qu'à un compte
# Google authentifié ayant une partie en cours. BYOK et « cache only » restent
# libres. Absent/autre = désactivé (comportement actuel).
ACCOUNT_GATED=

# Origine publique du serveur (ex. https://quiz.example.com). Sert à construire les
# URLs de redirection OAuth et de retour Stripe. Si absente, déduite de la requête
# (Host + X-Forwarded-Proto).
APP_ORIGIN=

# OAuth Google (Google Cloud Console > API & Services > Identifiants > ID client OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection enregistrée côté Google, du type :
#   https://quiz.example.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Stripe (paiement du pack de parties). Clé secrète + secret de webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email du compte administrateur (accès à la page d'administration des comptes).
ADMIN_USER_EMAIL=

# Réglages de l'offre (modifiables sans rebuild — lus au démarrage du serveur).
#   3 parties gratuites par mois, pack de 20 parties à 2,00 (dans la devise Stripe).
FREE_GAMES_PER_MONTH=3
PACK_PRICE_CENTS=200
PACK_CREDITS=20

# Chemin de la base de comptes (défaut : .accounts.db à la racine du projet).
# ACCOUNTS_DB=

